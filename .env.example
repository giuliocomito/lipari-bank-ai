# Copia questo file in .env e compila le righe vuote. Il .env resta fuori dai commit.

# Nome mostrato da /health e nella documentazione su /docs
APP_NAME=LipariBank AI
# development, test o production
ENVIRONMENT=development
# true solo in sviluppo
DEBUG=false
# Obbligatoria: postgresql+asyncpg://utente:password@host:5432/nome
DATABASE_URL=postgresql+asyncpg://lipari:lipari@localhost:5432/lipari_ai
# Obbligatoria, almeno 32 caratteri: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Dal Giorno 4 serve la chiave del fornitore di DEFAULT_MODEL (per i modelli claude-... è ANTHROPIC_API_KEY)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Modello della chat e della categorizzazione; il prefisso determina il fornitore.
# claude-opus-5-5, claude-haiku-5-5 (circa 40 volte più economico) o gpt-4o-mini
DEFAULT_MODEL=claude-opus-5-5
# Quanto ragiona Claude prima di rispondere, e dunque quanto spende: low, medium o high
LLM_EFFORT=low
# Modello degli embedding, dal Giorno 5: bge-m3 in locale con Ollama (ollama pull bge-m3)
EMBEDDING_MODEL=bge-m3
# Indirizzo dell'API degli embedding: Ollama sul proprio PC, compatibile con quella di OpenAI
EMBEDDING_BASE_URL=http://localhost:11434/v1
# Tetto di token per singola richiesta al modello (con Claude comprende il ragionamento)
MAX_TOKENS_PER_REQUEST=2000
# Tetto di spesa giornaliero del modello, in euro: una volta superato, la chat risponde 429
DAILY_BUDGET_EUR=5.00
# Pagine che possono chiamare l'API dal browser, elencate come lista JSON
CORS_ORIGINS=["http://localhost:5173"]
