# Copia questo file in .env e riempi le righe vuote. .env non si committa.

# Nome mostrato da /health e nella documentazione su /docs
APP_NAME=LipariBank AI
# development, test o production
ENVIRONMENT=development
# true solo in sviluppo
DEBUG=false
# Obbligatoria: postgresql+asyncpg://utente:password@host:5432/nome
DATABASE_URL=postgresql+asyncpg://lipari:lipari@localhost:5432/lipari_ai
# Obbligatoria, almeno 32 caratteri: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Dal Giorno 4: serve la chiave del fornitore di DEFAULT_MODEL (claude-... → ANTHROPIC_API_KEY)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Il modello della chat e della categorizzazione: il prefisso sceglie il fornitore.
# claude-opus-5-5, oppure claude-haiku-5-5 (circa 40 volte più economico), oppure gpt-4o-mini
DEFAULT_MODEL=claude-opus-5-5
# Quanto ragiona Claude prima di rispondere, e quindi quanto spende: low, medium o high
LLM_EFFORT=low
# Il modello degli embedding, dal Giorno 5: bge-m3, locale, con Ollama (ollama pull bge-m3)
EMBEDDING_MODEL=bge-m3
# Dove risponde l'API degli embedding: Ollama sul proprio PC, compatibile con quella di OpenAI
EMBEDDING_BASE_URL=http://localhost:11434/v1
# Tetto di token per singola richiesta al modello (con Claude comprende il ragionamento)
MAX_TOKENS_PER_REQUEST=2000
# Tetto di spesa del modello al giorno, in euro: superato, la chat risponde 429
DAILY_BUDGET_EUR=5.00
# Le pagine che possono chiamare l'API dal browser: una lista, scritta in JSON
CORS_ORIGINS=["http://localhost:5173"]
